rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users: own profile only ─────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /scores/{scoreId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Chats: participants only ────────────────────────
    // A chat's participants[] array contains the caregiver uid and the doctorId (placeId).
    // Only the authenticated caregiver who created the chat can read/write it.
    match /chats/{chatId} {
      // Allow read/write only if the caller's uid is in the participants list
      allow read:   if request.auth != null
                    && request.auth.uid in resource.data.participants;

      // Allow creating a new chat only if the creator includes themselves
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.caregiverId == request.auth.uid;

      // Allow update only if the caller is already a participant
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      allow delete: if false; // chats are never deleted

      // ── Messages subcollection ──────────────────────
      match /messages/{messageId} {
        // Read messages: must be a participant in the parent chat
        allow read:   if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        // Write messages: must be authenticated participant AND sender must match uid
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;

        // Allow update only to mark messages as read (participants only)
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if false;
      }
    }

    // ── Doctor Profiles: read-only for authenticated users ──
    // Written by Cloud Functions only (no client write path)
    match /doctorProfiles/{placeId} {
      allow read:   if request.auth != null;
      allow write:  if false; // Cloud Functions write via Admin SDK (bypasses rules)
    }

  }
}